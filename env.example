# Copy this file to .env before running docker compose.
# Bearer token trusted callers must send as `Authorization: Bearer <token>`
AUTH_TOKEN=changeme-generate-a-long-random-token

REDIS_URL=redis://redis:6379/0

# Host port the API is published on, bound to 127.0.0.1 only (see
# docker-compose.yml) - point a reverse proxy (e.g. Caddy) at this port.
# Change it if 8000 is already used by another service on this host.
APP_PORT=8000

# crawl4ai sidecar (Stage 4). CRAWL4AI_API_TOKEN is REQUIRED, not optional:
# crawl4ai's server (>=0.9.0) binds to loopback only and is unreachable from
# other containers unless this is set - generate a real random value, e.g.
# `openssl rand -hex 32`, matching crawl4ai's own recommendation.
CRAWL4AI_BASE_URL=http://crawl4ai:11235
CRAWL4AI_API_TOKEN=changeme-crawl4ai-token

# Stage 3 (Playwright-via-proxy) is stubbed and disabled until a provider is wired in
PROXY_ENABLED=false

# Crawl identity used for robots.txt matching and outbound requests
USER_AGENT=ccscraper/0.1 (+https://example.invalid/bot)

# Per-stage timeout budgets (seconds)
STAGE1_TIMEOUT_SECONDS=10
STAGE2_TIMEOUT_SECONDS=40
STAGE4_TIMEOUT_SECONDS=55
JOB_TIMEOUT_SECONDS=120

# Caching / retention
ROBOTS_CACHE_TTL_SECONDS=86400
JOB_RESULT_TTL_SECONDS=259200

# Stage 2/3 browser pool - caps concurrent Chromium contexts (memory control)
STAGE2_MAX_CONTEXTS=4

# Politeness: max concurrent in-flight fetches to any single host, regardless
# of robots.txt Crawl-delay (which may specify none at all)
PER_DOMAIN_MAX_CONCURRENCY=2

# Stage 5: remember which stage last succeeded per domain, to skip stages
# already known to fail for it. TTL bounds how long a stale memory persists.
DOMAIN_MEMORY_ENABLED=true
DOMAIN_MEMORY_TTL_SECONDS=604800
