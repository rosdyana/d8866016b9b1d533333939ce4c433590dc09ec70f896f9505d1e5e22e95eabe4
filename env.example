# Copy this file to .env before running docker compose.
# Bearer token trusted callers must send as `Authorization: Bearer <token>`
AUTH_TOKEN=changeme-generate-a-long-random-token

REDIS_URL=redis://redis:6379/0

# Host port the API is published on, bound to 127.0.0.1 only (see
# docker-compose.yml) - point a reverse proxy (e.g. Caddy) at this port.
# Change it if 8000 is already used by another service on this host.
APP_PORT=8000

# Used ONLY to match robots.txt directives. No stage sends this - each
# presents the coherent identity its own impersonation layer generates, and
# overriding that here is what would break the fingerprint.
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36

# Stage 1 TLS/JA3 + HTTP/2 fingerprint. Leave version-less ("chrome") so it
# tracks curl_cffi's newest target instead of pinning one that ages out.
CURL_IMPERSONATE_TARGET=chrome

# Per-stage timeout budgets (seconds). Stages 2, 3 and 4 launch a real
# browser per job, so their budgets are much larger than a plain HTTP fetch
# needs; stage 5 is a hosted API that may queue.
#   1 curl_cffi  2 crawl4ai  3 camoufox  4 seleniumbase  5 firecrawl
STAGE1_TIMEOUT_SECONDS=15
STAGE2_TIMEOUT_SECONDS=45
STAGE3_TIMEOUT_SECONDS=45
STAGE4_TIMEOUT_SECONDS=90
STAGE5_TIMEOUT_SECONDS=90
# Must exceed the sum of the stage budgets (285s) or a cold, hard URL is
# killed mid-chain and reported as `timeout` rather than reaching the stage
# that could have fetched it. Note this exceeds the MCP tool's 300s
# wait_seconds cap: such a job comes back as a job_id to poll.
JOB_TIMEOUT_SECONDS=360

# Stage 5 (Firecrawl) is a paid third-party API and the only stage that
# sends the target URL off this host. Leave empty to omit it from the chain
# entirely - the pipeline is then the four local stages.
FIRECRAWL_API_KEY=
# How stale a Firecrawl-indexed copy may be before it refetches (ms, 48h).
# Independent of this service's own response cache.
FIRECRAWL_MAX_AGE_MS=172800000

# Comma-separated Host allowlist for the MCP endpoint at /mcp, e.g.
# MCP_ALLOWED_HOSTS=scraper.example.com,scraper.example.com:*
# Leave empty behind a reverse proxy that sets Host (the setup above): the
# MCP SDK otherwise arms DNS-rebinding protection with a localhost-only
# allowlist and answers 421 Misdirected Request to everything Caddy
# forwards, logging the reason server-side only.
MCP_ALLOWED_HOSTS=

# Caching / retention
ROBOTS_CACHE_TTL_SECONDS=86400
JOB_RESULT_TTL_SECONDS=259200

# Response cache, keyed on the whole request body (url + formats +
# robotstxt). A repeat of an identical body is answered from Redis instead
# of re-running the pipeline, which for a bot-protected vendor page means a
# browser launch measured in tens of seconds plus one of the few browser
# slots. Only successes are stored: a transient block cached for 30 days
# would poison that URL for a month. Send "refresh": true on a request to
# fetch again anyway.
SCRAPE_CACHE_ENABLED=true
SCRAPE_CACHE_TTL_SECONDS=2592000

# Redis runs with no maxmemory and the default noeviction policy, and
# raw_html is routinely megabytes - a result larger than this is served
# normally but not cached, so one pathological page can't stay pinned for
# the whole 30 days.
SCRAPE_CACHE_MAX_ENTRY_BYTES=2097152

# Caps concurrent browsers for stages 2, 3 and 4. Each slot is a whole
# browser process (fresh fingerprint per job), not a context off a shared
# one, so this is far more expensive per unit than the old context pool.
MAX_CONCURRENT_BROWSERS=2

# Per-engine, because they measurably want different things. Camoufox must
# stay off Xvfb: its WebGL spoof claims a GTX 980 while the container
# software-renders, and Akamai catches the contradiction - store.acer.com's
# challenge never cleared under Xvfb (3/3) and cleared in ~5.5s headless
# (3/3), with neither mode flagged by bot.sannysoft.com or browserscan.net.
STAGE3_USE_XVFB=false
# Stage 4 keeps it: headless Chromium *is* trivially detectable.
# Linux only - set false for local macOS/Windows dev.
STAGE4_USE_XVFB=true
# Stage 2 is Playwright Chromium, but crawl4ai's stealth patches target
# headless and it has no Xvfb path, so it gets an on/off, not a display knob.
STAGE2_HEADLESS=true

# Politeness: max concurrent in-flight fetches to any single host, regardless
# of robots.txt Crawl-delay (which may specify none at all)
PER_DOMAIN_MAX_CONCURRENCY=2

# Remember which stage last succeeded per domain, to skip stages already
# known to fail for it. This matters more now that every stage after the
# first launches a browser: a host that needs Camoufox pays Stage 1's cost
# once, then goes straight to Camoufox for the TTL.
DOMAIN_MEMORY_ENABLED=true
DOMAIN_MEMORY_TTL_SECONDS=604800
