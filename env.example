# Copy this file to .env before running docker compose.
# Bearer token trusted callers must send as `Authorization: Bearer <token>`
AUTH_TOKEN=changeme-generate-a-long-random-token

REDIS_URL=redis://redis:6379/0

# Host port the API is published on, bound to 127.0.0.1 only (see
# docker-compose.yml) - point a reverse proxy (e.g. Caddy) at this port.
# Change it if 8000 is already used by another service on this host.
APP_PORT=8000

# Used ONLY to match robots.txt directives. No stage sends this - each
# presents the coherent identity its own impersonation layer generates, and
# overriding that here is what would break the fingerprint.
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36

# Stage 1 TLS/JA3 + HTTP/2 fingerprint. Leave version-less ("chrome") so it
# tracks curl_cffi's newest target instead of pinning one that ages out.
CURL_IMPERSONATE_TARGET=chrome

# Per-stage timeout budgets (seconds). Stages 2 and 3 launch a real browser
# per job, so their budgets are much larger than a plain HTTP fetch needs.
STAGE1_TIMEOUT_SECONDS=15
STAGE2_TIMEOUT_SECONDS=45
STAGE3_TIMEOUT_SECONDS=90
JOB_TIMEOUT_SECONDS=180

# Caching / retention
ROBOTS_CACHE_TTL_SECONDS=86400
JOB_RESULT_TTL_SECONDS=259200

# Caps concurrent browsers for stages 2 and 3. Each slot is a whole browser
# process (fresh fingerprint per job), not a context off a shared one, so
# this is far more expensive per unit than the old context pool.
MAX_CONCURRENT_BROWSERS=2

# Run stages 2/3 on a virtual display (Xvfb) instead of true headless, which
# is trivially detectable. Linux only - set false for local macOS/Windows dev.
BROWSER_USE_XVFB=true

# Politeness: max concurrent in-flight fetches to any single host, regardless
# of robots.txt Crawl-delay (which may specify none at all)
PER_DOMAIN_MAX_CONCURRENCY=2

# Remember which stage last succeeded per domain, to skip stages already
# known to fail for it. This matters more now that every stage after the
# first launches a browser: a host that needs Camoufox pays Stage 1's cost
# once, then goes straight to Camoufox for the TTL.
DOMAIN_MEMORY_ENABLED=true
DOMAIN_MEMORY_TTL_SECONDS=604800
